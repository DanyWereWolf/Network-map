{
  "name": "network-map-portable",
  "version": "1.2.0",
  "description": "Карта оптической сети — портативная on-prem версия (без SaaS)",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/ensure-first-run.js",
    "api": "node scripts/ensure-first-run.js && node server/server-api.js",
    "sync": "node server/server.js",
    "check": "node scripts/check-js-syntax.js",
    "db:migrate": "node server/db/migrate.js",
    "db:status": "node scripts/mysql-status.js",
    "migrate:mysql": "node scripts/migrate-store-to-mysql.js",
    "setup:mysql": "node scripts/configure-mysql-storage.js",
    "backup:mysql": "node scripts/mysql-backup.js",
    "restore:mysql": "node scripts/mysql-restore.js",
    "release": "node scripts/build-release.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "geotiff": "^3.0.5",
    "multer": "^2.4.0",
    "mysql2": "^3.23.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "ws": "^8.18.0"
  },
  "author": "Карта оптической сети",
  "license": "SEE LICENSE FILE"
}
