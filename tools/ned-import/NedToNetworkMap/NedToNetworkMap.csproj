<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NedToNetworkMap</RootNamespace>
    <AssemblyName>NedToNetworkMap</AssemblyName>
    <NoWarn>$(NoWarn);SYSLIB5005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.0" />
  </ItemGroup>
</Project>
