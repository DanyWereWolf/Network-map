  "description": "Карта оптической сети — программа для работы с оптической сетью на Яндекс.Картах",
  "private": true,
  "scripts": {
    "build": "node scripts/build-client.js",
    "sync": "node server/server.js",
    "api": "node server/server-api.js",
    "check": "node scripts/check-js-syntax.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
