    "speakeasy": "^2.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "javascript-obfuscator": "^4.1.1",
    "knip": "^6.15.0",
    "prettier": "^3.8.3"
